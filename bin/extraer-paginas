#!/usr/bin/env python3
import sys
import os

sys.path.insert(
    0,
    os.path.expanduser("~/.local/share/nemo-pdf-tools/lib")
)

from pdf_tools import parse_pages

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

from pypdf import PdfReader, PdfWriter




class ExtractPDFWindow(Gtk.Window):

    def __init__(self, filename):

        Gtk.Window.__init__(
            self,
            title="Extraer páginas"
        )

        self.filename = os.path.abspath(filename)

        self.set_border_width(12)
        self.set_default_size(600, 260)
        self.set_position(
            Gtk.WindowPosition.CENTER
        )

        try:
            self.reader = PdfReader(self.filename)
            self.num_pages = len(self.reader.pages)

        except Exception as e:

            self.reader = None
            self.num_pages = 0

            self.error(
                "No se pudo abrir el PDF:\n\n" + str(e)
            )

            return

        # --------------------------------------------------
        # Layout
        # --------------------------------------------------

        vbox = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=10
        )

        self.add(vbox)

        # Archivo

        label = Gtk.Label()

        label.set_markup(
            "<b>Archivo:</b> " +
            GLib.markup_escape_text(
                os.path.basename(self.filename)
            )
        )

        label.set_xalign(0)

        vbox.pack_start(
            label,
            False,
            False,
            0
        )

        # Número de páginas

        info = Gtk.Label(
            label=(
                f"El documento tiene "
                f"{self.num_pages} páginas."
            )
        )

        info.set_xalign(0)

        vbox.pack_start(
            info,
            False,
            False,
            0
        )

        # --------------------------------------------------
        # Páginas
        # --------------------------------------------------

        pages_label = Gtk.Label(
            label="Páginas a extraer:"
        )

        pages_label.set_xalign(0)

        vbox.pack_start(
            pages_label,
            False,
            False,
            0
        )

        self.pages_entry = Gtk.Entry()

        self.pages_entry.set_placeholder_text(
            "Ejemplo: 1-3,7,10-12"
        )

        vbox.pack_start(
            self.pages_entry,
            False,
            False,
            0
        )

        help_label = Gtk.Label(
            label=(
                "Podés indicar páginas individuales "
                "o rangos separados por comas."
            )
        )

        help_label.set_xalign(0)

        vbox.pack_start(
            help_label,
            False,
            False,
            0
        )

        # --------------------------------------------------
        # Archivo de salida
        # --------------------------------------------------

        output_box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=6
        )

        output_label = Gtk.Label(
            label="Archivo de salida:"
        )

        output_label.set_xalign(0)

        self.output_entry = Gtk.Entry()

        directory = os.path.dirname(
            self.filename
        )

        basename = os.path.splitext(
            os.path.basename(self.filename)
        )[0]

        default_output = os.path.join(
            directory,
            basename + "_extraido.pdf"
        )

        self.output_entry.set_text(
            default_output
        )

        browse = Gtk.Button(
            label="Elegir..."
        )

        browse.connect(
            "clicked",
            self.choose_output
        )

        output_box.pack_start(
            output_label,
            False,
            False,
            0
        )

        output_box.pack_start(
            self.output_entry,
            True,
            True,
            0
        )

        output_box.pack_start(
            browse,
            False,
            False,
            0
        )

        vbox.pack_start(
            output_box,
            False,
            False,
            0
        )

        # --------------------------------------------------
        # Botones
        # --------------------------------------------------

        button_box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=6
        )

        cancel = Gtk.Button(
            label="Cancelar"
        )

        extract = Gtk.Button(
            label="Extraer"
        )

        cancel.connect(
            "clicked",
            self.cancel
        )

        extract.connect(
            "clicked",
            self.extract
        )

        button_box.pack_end(
            extract,
            False,
            False,
            0
        )

        button_box.pack_end(
            cancel,
            False,
            False,
            0
        )

        vbox.pack_start(
            button_box,
            False,
            False,
            0
        )

        self.connect(
            "key-press-event",
            self.key_press
        )

        self.pages_entry.grab_focus()

    # --------------------------------------------------

    def choose_output(self, button):

        dialog = Gtk.FileChooserDialog(
            title="Elegir archivo PDF",
            parent=self,
            action=Gtk.FileChooserAction.SAVE
        )

        dialog.add_buttons(
            Gtk.STOCK_CANCEL,
            Gtk.ResponseType.CANCEL,
            Gtk.STOCK_SAVE,
            Gtk.ResponseType.ACCEPT
        )

        dialog.set_do_overwrite_confirmation(
            True
        )

        current = self.output_entry.get_text()

        if current:

            directory = os.path.dirname(current)
            filename = os.path.basename(current)

            if os.path.isdir(directory):
                dialog.set_current_folder(
                    directory
                )

            dialog.set_current_name(
                filename
            )

        response = dialog.run()

        if response == Gtk.ResponseType.ACCEPT:

            filename = dialog.get_filename()

            if not filename.lower().endswith(".pdf"):
                filename += ".pdf"

            self.output_entry.set_text(
                filename
            )

        dialog.destroy()

    # --------------------------------------------------

    def extract(self, button):

        page_text = (
            self.pages_entry
            .get_text()
            .strip()
        )

        if not page_text:

            self.error(
                "Indicá las páginas que querés extraer."
            )

            return

        try:

            pages = parse_pages(
                page_text,
                self.num_pages
            )

        except ValueError as e:

            self.error(str(e))

            return

        output = (
            self.output_entry
            .get_text()
            .strip()
        )

        if not output:

            self.error(
                "Elegí un archivo de salida."
            )

            return

        output = os.path.abspath(
            os.path.expanduser(output)
        )

        if os.path.abspath(output) == \
                os.path.abspath(self.filename):

            self.error(
                "El archivo de salida no puede "
                "ser el archivo original."
            )

            return

        try:

            writer = PdfWriter()

            for index in pages:
                writer.add_page(
                    self.reader.pages[index]
                )

            with open(output, "wb") as f:
                writer.write(f)

        except Exception as e:

            self.error(
                "No se pudo crear el PDF:\n\n" +
                str(e)
            )

            return

        dialog = Gtk.MessageDialog(
            parent=self,
            flags=0,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text="Páginas extraídas correctamente"
        )

        dialog.format_secondary_text(
            f"Se extrajeron {len(pages)} páginas:\n"
            f"{page_text}\n\n"
            f"Archivo:\n{output}"
        )

        dialog.run()
        dialog.destroy()

        self.destroy()
        Gtk.main_quit()

    # --------------------------------------------------

    def cancel(self, button):

        self.destroy()
        Gtk.main_quit()

    # --------------------------------------------------

    def error(self, message):

        dialog = Gtk.MessageDialog(
            parent=self,
            flags=0,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text="Error"
        )

        dialog.format_secondary_text(
            message
        )

        dialog.run()
        dialog.destroy()

    # --------------------------------------------------

    def key_press(self, widget, event):

        if event.keyval == 65307:  # Escape
            self.cancel(None)

        elif event.keyval == 65293:  # Enter
            self.extract(None)


def main():

    files = [
        f
        for f in sys.argv[1:]
        if os.path.isfile(f)
        and f.lower().endswith(".pdf")
    ]

    if len(files) != 1:

        print(
            "Seleccioná exactamente un archivo PDF."
        )

        return 1

    win = ExtractPDFWindow(files[0])

    win.show_all()

    Gtk.main()

    return 0


if __name__ == "__main__":
    sys.exit(main())
