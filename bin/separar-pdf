#!/usr/bin/env python3

import os
import sys

sys.path.insert(
    0,
    os.path.expanduser("~/.local/share/nemo-pdf-tools/lib")
)

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

from pypdf import PdfReader, PdfWriter


class SplitPDFWindow(Gtk.Window):

    def __init__(self, filename):
        Gtk.Window.__init__(self, title="Separar PDF")

        self.filename = os.path.abspath(filename)

        self.set_border_width(12)
        self.set_default_size(500, 220)
        self.set_position(Gtk.WindowPosition.CENTER)

        vbox = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=10
        )
        self.add(vbox)

        # Archivo
        label = Gtk.Label()
        label.set_markup(
            "<b>Archivo:</b> " +
            GLib.markup_escape_text(
                os.path.basename(self.filename)
            )
        )
        label.set_xalign(0)
        vbox.pack_start(label, False, False, 0)

        # Información
        try:
            reader = PdfReader(self.filename)
            self.num_pages = len(reader.pages)
        except Exception as e:
            self.num_pages = 0
            self.error("No se pudo abrir el PDF:\n\n" + str(e))
            return

        info = Gtk.Label(
            label=f"El documento tiene {self.num_pages} páginas."
        )
        info.set_xalign(0)
        vbox.pack_start(info, False, False, 0)

        # Directorio de salida
        output_box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=6
        )

        output_label = Gtk.Label(label="Directorio:")
        output_label.set_xalign(0)

        self.output_entry = Gtk.Entry()

        directory = os.path.dirname(self.filename)
        self.output_entry.set_text(directory)

        browse = Gtk.Button(label="Elegir...")
        browse.connect("clicked", self.choose_directory)

        output_box.pack_start(output_label, False, False, 0)
        output_box.pack_start(self.output_entry, True, True, 0)
        output_box.pack_start(browse, False, False, 0)

        vbox.pack_start(output_box, False, False, 0)

        # Botones
        button_box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=6
        )

        cancel = Gtk.Button(label="Cancelar")
        split = Gtk.Button(label="Separar")

        cancel.connect("clicked", self.cancel)
        split.connect("clicked", self.split)

        button_box.pack_end(split, False, False, 0)
        button_box.pack_end(cancel, False, False, 0)

        vbox.pack_start(button_box, False, False, 0)

    def choose_directory(self, button):

        dialog = Gtk.FileChooserDialog(
            title="Elegir directorio",
            parent=self,
            action=Gtk.FileChooserAction.SELECT_FOLDER
        )

        dialog.add_buttons(
            Gtk.STOCK_CANCEL,
            Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OPEN,
            Gtk.ResponseType.ACCEPT
        )

        response = dialog.run()

        if response == Gtk.ResponseType.ACCEPT:
            self.output_entry.set_text(
                dialog.get_filename()
            )

        dialog.destroy()

    def split(self, button):

        output_dir = self.output_entry.get_text().strip()

        if not output_dir:
            self.error("Elegí un directorio de salida.")
            return

        output_dir = os.path.abspath(
            os.path.expanduser(output_dir)
        )

        os.makedirs(output_dir, exist_ok=True)

        basename = os.path.splitext(
            os.path.basename(self.filename)
        )[0]

        try:
            reader = PdfReader(self.filename)

            for i, page in enumerate(reader.pages, start=1):

                writer = PdfWriter()
                writer.add_page(page)

                output = os.path.join(
                    output_dir,
                    f"{basename}_{i:03d}.pdf"
                )

                with open(output, "wb") as f:
                    writer.write(f)

        except Exception as e:
            self.error(
                "No se pudo separar el PDF:\n\n" + str(e)
            )
            return

        dialog = Gtk.MessageDialog(
            parent=self,
            flags=0,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text="PDF separado correctamente"
        )

        dialog.format_secondary_text(
            f"Se crearon {self.num_pages} archivos en:\n"
            f"{output_dir}"
        )

        dialog.run()
        dialog.destroy()

        self.destroy()
        Gtk.main_quit()

    def cancel(self, button):
        self.destroy()
        Gtk.main_quit()

    def error(self, message):

        dialog = Gtk.MessageDialog(
            parent=self,
            flags=0,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.OK,
            text="Error"
        )

        dialog.format_secondary_text(message)
        dialog.run()
        dialog.destroy()


def main():

    files = [
        f for f in sys.argv[1:]
        if os.path.isfile(f)
        and f.lower().endswith(".pdf")
    ]

    if len(files) != 1:
        print("Seleccioná exactamente un archivo PDF.")
        return 1

    win = SplitPDFWindow(files[0])
    win.show_all()

    Gtk.main()

    return 0


if __name__ == "__main__":
    main()
