#!/usr/bin/env python3

import os
import sys

sys.path.insert(
    0,
    os.path.expanduser("~/.local/share/nemo-pdf-tools/lib")
)

from pypdf import PdfWriter


def main():
    files = sys.argv[1:]

    if len(files) < 2:
        print("Se necesitan al menos dos archivos PDF.", file=sys.stderr)
        return 1

    # Solo archivos PDF
    files = [
        os.path.abspath(f)
        for f in files
        if os.path.isfile(f) and f.lower().endswith(".pdf")
    ]

    if len(files) < 2:
        print("No hay suficientes archivos PDF.", file=sys.stderr)
        return 1

    # El nombre se construye a partir del primer PDF
    first = files[0]
    directory = os.path.dirname(first)
    basename = os.path.splitext(os.path.basename(first))[0]

    output = os.path.join(
        directory,
        basename + "_joined.pdf"
    )

    # Evitar unir accidentalmente el archivo de salida consigo mismo
    files = [f for f in files if os.path.abspath(f) != os.path.abspath(output)]

    writer = PdfWriter()

    try:
        for filename in files:
            print(f"Agregando: {filename}")
            writer.append(filename)

        if os.path.exists(output):
            os.remove(output)

        with open(output, "wb") as f:
            writer.write(f)

    except Exception as e:
        print(f"Error al unir los PDF: {e}", file=sys.stderr)

        if os.path.exists(output):
            os.remove(output)

        return 1

    print(f"\nPDF creado:\n{output}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
